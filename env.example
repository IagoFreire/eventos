# API Backend
# Para desenvolvimento local:
VITE_API_URL=http://localhost:3000/api

# Para produção, crie um arquivo .env.production com:
# VITE_API_URL=https://eventos.iagofreire.dev/api

# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mercado Pago
VITE_MERCADO_PAGO_PUBLIC_KEY=your_mercado_pago_public_key

# Modo Offline (use 'npm run dev-offline' ao invés de configurar manualmente)
# VITE_OFFLINE_MODE=true
