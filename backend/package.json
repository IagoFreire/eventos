{
  "name": "eventos-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de gerenciamento de eventos",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx database/migrate.ts",
    "seed": "tsx database/seed.ts",
    "db:setup": "npm run migrate && npm run seed",
    "db:reset": "echo 'CUIDADO: Isso vai apagar todos os dados!' && npm run migrate && npm run seed",
    "create-admin": "tsx scripts/create-admin.ts",
    "test-login": "tsx scripts/test-login.ts",
    "test-hash": "tsx scripts/test-hash.ts"
  },
  "keywords": ["eventos", "api", "backend"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "mercadopago": "^2.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
